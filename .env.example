LOCALE=en

# Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Required for TC-AI-003 and TC-AI-004 (AI visual/text validation tests).
# Leave empty to skip those tests.
GEMINI_API_KEY=your_gemini_api_key_here

# Report Portal Configuration
# Get your API key from Report Portal: User Profile -> API Keys
RP_ENDPOINT=https://reportportal.epam.com/api/v1
RP_API_KEY=your_api_key_here
RP_PROJECT=your_personal_project_name
RP_LAUNCH=Playwright Tests
